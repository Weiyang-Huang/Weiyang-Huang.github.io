{% if site.mapmyvisitors.enabled and site.mapmyvisitors.widget_id %}
  <div class="visitor-map" aria-label="Website visitor globe">
    <div class="visitor-map-inner">
      <script
        type="text/javascript"
        id="mmvst_globe"
        src="https://mapmyvisitors.com/globe.js?d={{ site.mapmyvisitors.widget_id }}&amp;x=y"
      ></script>
    </div>
  </div>
{% endif %}
